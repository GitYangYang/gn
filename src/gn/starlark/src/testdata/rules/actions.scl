ActionInfo = provider(fields = ["out_file"])

def _write_rule_impl(ctx):
  declared = ctx.actions.declare_file("declared.txt")
  ctx.actions.write(output = declared, content = str(ctx.label))
  undeclared = ctx.actions.declare_file("undeclared.txt")
  ctx.actions.write(output = undeclared, content = "undeclared")
  return [
    DefaultInfo(files = depset([declared])),
    ActionInfo(out_file = undeclared),
  ]

write_rule = rule(
  implementation = _write_rule_impl,
)

def _label_rule_impl(ctx):
  out = ctx.actions.declare_file(ctx.label.name + ".txt")
  ctx.actions.write(
    output = out,
    content = "label",
  )
  return [ActionInfo(out_file = out)]

label_rule = rule(
  implementation = _label_rule_impl,
)

def _empty_filename_rule_impl(ctx):
  ctx.actions.declare_file("")
  return []

empty_filename_rule = rule(
  implementation = _empty_filename_rule_impl,
)

def _duplicate_declare_file_rule_impl(ctx):
  ctx.actions.declare_file("dup.txt")
  ctx.actions.declare_file("dup.txt")
  return []

duplicate_declare_file_rule = rule(
  implementation = _duplicate_declare_file_rule_impl,
)

def _already_generated_rule_impl(ctx):
  out = ctx.actions.declare_file("gen.txt")
  ctx.actions.write(
    output = out,
    content = "first",
  )
  ctx.actions.write(
    output = out,
    content = "second",
  )
  return []

already_generated_rule = rule(
  implementation = _already_generated_rule_impl,
)

def _undeclared_output_rule_impl(ctx):
  ctx.actions.write(
    output = ctx.files.src[0],
    content = "fail",
  )
  return []

undeclared_output_rule = rule(
  implementation = _undeclared_output_rule_impl,
  attrs = {
    "src": attr.label(allow_files = True),
  },
)

def _never_generated_rule_impl(ctx):
  ctx.actions.declare_file("forgotten.txt")
  return []

never_generated_rule = rule(
  implementation = _never_generated_rule_impl,
)
